{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Ya no hay `.next` que construir: `apps/admin` (Next + Supabase) se retiró en E12.5.
      "outputs": ["dist/**"]
      // Sin `env`: las 7 variables que había acá eran de Supabase/PowerSync, muertas desde el cutover
      // a D1 (§11.3). Ninguna aparece en el código; declararlas solo ensuciaba la llave de caché.
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "outputs": []
    },
    "test:e2e": {
      // Sin caché: el smoke levanta un Worker y escribe en una base D1 — su valor está en correr de
      // verdad, no en que turbo recuerde que la última vez salió verde.
      "cache": false,
      "outputs": ["playwright-report/**"]
    }
  }
}
