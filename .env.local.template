# Copiar a .env.local y completar con los valores reales del proyecto Supabase Free que creaste.
# NUNCA commitear .env.local — está en .gitignore.

# ===========================================================
# Supabase Free (sprint 1 — el proyecto que recién creaste)
# Obtener desde: Supabase Dashboard → Project Settings → API
# ===========================================================
VITE_SUPABASE_URL=https://<tu-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Mismo URL + anon key para admin (Next.js usa prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://<tu-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SERVICE ROLE — NUNCA exponer al frontend. Solo server-side (admin Next.js + scripts).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===========================================================
# PowerSync (sprint 1 día 3-4 — validación SDK)
# Crear cuenta gratis: https://www.powersync.com → instance
# ===========================================================
VITE_POWERSYNC_URL=

# ===========================================================
# Sentry (sprint 1 — opcional, plan Free)
# ===========================================================
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ===========================================================
# n8n self-hosted (sprint 6+) — usar n8n local con Docker
# ===========================================================
N8N_WEBHOOK_BASE_URL=http://localhost:5678
