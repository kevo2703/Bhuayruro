{
  "name": "@huayruro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply huayruro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply huayruro-db --remote",
    "db:seed:local": "wrangler d1 execute huayruro-db --local --file ./seeds/0001_seed_p0.sql",
    "db:seed:remote": "wrangler d1 execute huayruro-db --remote --file ./seeds/0001_seed_p0.sql"
  },
  "dependencies": {
    "@huayruro/shared": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20250109.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.4.0"
  }
}
