{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huayruro",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huayruro-db",
      "database_id": "da708485-cabe-4c4a-a05a-113a49f69603"
    }
  ]
}
