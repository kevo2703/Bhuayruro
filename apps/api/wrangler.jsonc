{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huayruro",
  // Entrada del Worker: fetch de Hono + scheduled del Cron (B10.1). src/index.ts sigue exportando el
  // app de Hono por defecto para los tests; src/worker.ts es la capa que Cloudflare invoca.
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Dos Cron (worker.ts ramifica por controller.cron):
  //   · "*/5 * * * *" barredora de audios 'subido' (la transcripción normal ocurre EN la ingesta, §8).
  //   · "0 8 * * *"   EBR nocturno (03:00 Lima): abre casos de excepción del día + autocierre (B11.1).
  "triggers": {
    "crons": ["*/5 * * * *", "0 8 * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huayruro-db",
      "database_id": "da708485-cabe-4c4a-a05a-113a49f69603"
    }
  ],
  // Bot de Telegram (B9): fotos en R2 + OCR con Workers AI. El bucket se crea con
  // `wrangler r2 bucket create huayruro-media` antes del primer deploy con el bot.
  // Los secretos TELEGRAM_BOT_TOKEN y TELEGRAM_WEBHOOK_SECRET van por `wrangler secret put`.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "huayruro-media"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
