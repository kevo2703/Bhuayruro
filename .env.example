# Variables compartidas — copia a .env.local y rellena
# NUNCA commitear .env.local

# Supabase (sprint 1 — proyecto Pro)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (NO exponer al frontend)
SUPABASE_SERVICE_ROLE_KEY=

# PowerSync (sprint 1)
VITE_POWERSYNC_URL=https://<instance>.powersync.journeyapps.com

# Sentry (sprint 1)
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# n8n Cloud (sprint 6+)
N8N_WEBHOOK_BASE_URL=

# WhatsApp Business API (sprint 6 fase 2)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
